{
  "name": "md-reader-mcp",
  "version": "0.2.0",
  "type": "module",
  "description": "MCP server exposing md-reader visual tools (mind map, treemap, knowledge graph, podcast, share URLs) for Claude Code",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/manup-dev/themarkdownreader.git",
    "directory": "mcp-server"
  },
  "bin": { "md-reader-mcp": "./dist/index.js" },
  "files": ["dist/**"],
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "open": "^10.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "tsx": "^4.0.0",
    "esbuild": "^0.21.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
