{
  "name": "@md-reader/app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-lib/md-reader.js",
  "types": "dist-lib/md-reader.d.ts",
  "exports": {
    ".": {
      "import": "./dist-lib/md-reader.js",
      "types": "./dist-lib/md-reader.d.ts"
    }
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "license": "MIT",
  "description": "Read it. Ship it. Comprehend any spec as a podcast or mind map, then highlight a passage and ship a grounded prompt to Claude Code — without the alt-tab. Local, offline, MIT.",
  "author": "md-reader contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/manup-dev/themarkdownreader.git"
  },
  "keywords": [
    "markdown",
    "reader",
    "ai",
    "ollama",
    "mind-map",
    "knowledge-graph",
    "tts"
  ],
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "//overrides": "Force-upgrade transitive deps to fixed versions without waiting for upstream propagation. Each entry must reference a published advisory (URLs in the matching comment). Review on every npm install and prune entries whose direct parent ships a clean release.",
  "overrides": {
    "protobufjs": "^7.5.6",
    "@protobufjs/utf8": "^1.1.1",
    "dompurify": "^3.3.4",
    "nanoid": "^5.0.9",
    "picomatch": "^4.0.3",
    "postcss": "^8.5.10",
    "yaml": "^2.9.0",
    "fast-uri": "^3.1.2",
    "lodash-es": "^4.18.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:extension": "node scripts/test-extension-manifest.mjs",
    "test:mcp": "vitest run --config mcp-server/vitest.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "eval": "tsx scripts/eval/runner.ts",
    "e2e": "npx playwright test",
    "e2e:headed": "npx playwright test --headed",
    "e2e:hosted": "npx playwright test --config=playwright.hosted.config.ts",
    "e2e:hosted:headed": "npx playwright test --config=playwright.hosted.config.ts --headed",
    "analyze": "ANALYZE=true npm run build",
    "build:cli": "npm run build && rm -rf cli/dist && cp -r dist cli/dist",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:jupyter": "vite build --config vite.jupyter.config.ts"
  },
  "dependencies": {
    "@ain1084/audio-worklet-stream": "^2.0.2",
    "@excalidraw/excalidraw": "^0.18.1",
    "@huggingface/transformers": "^4.2.0",
    "@mlc-ai/web-llm": "^0.2.82",
    "d3": "^7.9.0",
    "d3-hierarchy": "^3.1.2",
    "dexie": "^4.3.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-metrics": "^2.4.0",
    "kokoro-js": "^1.2.1",
    "lucide-react": "^0.577.0",
    "markmap-common": "^0.18.9",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "mermaid": "^11.14.0",
    "minisearch": "^7.2.0",
    "murmurhash-js": "^1.0.0",
    "posthog-js": "^1.363.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "umap-js": "^1.4.0",
    "unified": "^11.0.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3": "^7.4.3",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/murmurhash-js": "^1.0.7",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.0"
  }
}
