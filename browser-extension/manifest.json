{
  "manifest_version": 3,
  "name": "md-reader",
  "version": "1.0.0",
  "description": "Enhanced reading for markdown files — TOC, reading progress, TTS, dark mode. Works on GitHub, GitLab, Gitea, and any site with markdown.",
  "permissions": ["activeTab", "storage"],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*",
        "https://gist.github.com/*",
        "https://raw.githubusercontent.com/*",
        "https://gitlab.com/*",
        "https://bitbucket.org/*",
        "https://codeberg.org/*"
      ],
      "js": ["markmap-bundle.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon48.png"
  }
}
