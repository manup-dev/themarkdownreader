{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": ["*.ts", "*.tsx", "renderers/**/*.ts", "renderers/**/*.tsx", "../shared/tree-parser.ts"],
  "exclude": ["**/*.test.ts", "dist"]
}
