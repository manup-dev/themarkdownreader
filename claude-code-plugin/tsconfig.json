{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "declaration": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["*.ts", "*.tsx", "renderers/**/*.ts", "renderers/**/*.tsx"],
  "exclude": ["*.test.ts", "dist"]
}
