{
  "name": "@md-reader/github-integration",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub Action that renders md-reader .annot sidecars into github.com-readable markdown companions.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e:act": "vitest run test/e2e/act.test.ts",
    "test:e2e:playwright": "playwright test",
    "test:e2e": "npm run test:e2e:act && npm run test:e2e:playwright"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
